@model QuanLyThuVien.Models.Sach

<div class="col">
    <div class="card h-100 border-0 shadow-sm hover-card">
        <!-- Ảnh bìa -->
        <div class="position-relative overflow-hidden" style="height: 280px;">
            <a asp-controller="Sach" asp-action="Details" asp-route-id="@Model.MaSach">
                <img src="@Model.AnhBia" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="@Model.TenSach">
            </a>
            
            <!-- Badge -->
            <div class="position-absolute top-0 end-0 m-2">
                @if(Model.CoSan) { <span class="badge bg-success shadow-sm">Có sẵn</span> }
                else { <span class="badge bg-secondary shadow-sm">Đã mượn</span> }
            </div>
        </div>

        <div class="card-body d-flex flex-column p-3">
            <!-- Tên sách -->
            <h6 class="card-title fw-bold text-truncate mb-1">
                <a asp-controller="Sach" asp-action="Details" asp-route-id="@Model.MaSach" class="text-decoration-none text-dark stretched-link">
                    @Model.TenSach
                </a>
            </h6>
            
            <!-- Tác giả -->
            <p class="card-text text-muted small mb-2">@Model.TacGia</p>
            
            <!-- Giá & Nút -->
            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="text-primary fw-bold small">
                    @(Model.Gia == 0 ? "Miễn phí" : Model.Gia.ToString("N0") + " đ")
                </span>
                <span class="btn btn-sm btn-light rounded-circle text-primary">
                    <i class="bi bi-arrow-right"></i>
                </span>
            </div>
        </div>
    </div>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Thư Viện</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuanLyThuVien.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 sticky-top shadow-sm">
        <div class="container">
            <!-- LOGO THƯ VIỆN -->
            <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half me-2"></i>Quản Lý Thư Viện
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <!-- MENU BÊN TRÁI (CHỨC NĂNG CHÍNH) -->
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Trang chủ
                        </a>
                    </li>
                    
                    <!-- DROPDOWN TÀI NGUYÊN -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-dark" href="#" id="resourceDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-collection"></i> Tài Nguyên
                        </a>
                        <ul class="dropdown-menu border-0 shadow" aria-labelledby="resourceDropdown">
                            <li><a class="dropdown-item" asp-controller="Sach" asp-action="Index"><i class="bi bi-grid-fill me-2 text-primary"></i>Tất cả tài liệu</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Sach" asp-action="Index" asp-route-loai="Sách"><i class="bi bi-book me-2 text-success"></i>Sách tham khảo</a></li>
                            <li><a class="dropdown-item" asp-controller="Sach" asp-action="Index" asp-route-loai="Giáo trình"><i class="bi bi-journal-bookmark me-2 text-warning"></i>Giáo trình</a></li>
                            <li><a class="dropdown-item" asp-controller="Sach" asp-action="Index" asp-route-loai="Tài liệu"><i class="bi bi-file-earmark-text me-2 text-info"></i>Luận văn / Đồ án</a></li>
                        </ul>
                    </li>

                    <!-- MENU ADMIN (CHỈ HIỆN KHI LÀ ADMIN) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown ms-lg-3">
                            <a class="nav-link dropdown-toggle btn btn-outline-danger border-0 text-danger fw-bold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock-fill"></i> Quản Trị
                            </a>
                            <ul class="dropdown-menu border-0 shadow" aria-labelledby="adminDropdown">
                                <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.8rem;">Nghiệp vụ</h6></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="QuanLyMuonTra"><i class="bi bi-arrow-left-right me-2"></i>Mượn Trả Sách</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.8rem;">Dữ liệu</h6></li>
                                <li><a class="dropdown-item" asp-controller="QuanLySach" asp-action="Index"><i class="bi bi-database me-2"></i>Quản Lý Sách</a></li>
                                <li><a class="dropdown-item" asp-controller="TheLoai" asp-action="Index"><i class="bi bi-tags me-2"></i>Quản Lý Thể Loại</a></li>
                                <li><h6 class="dropdown-header text-uppercase text-muted" style="font-size: 0.8rem;">Thống kê</h6></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Report"><i class="bi bi-graph-up-arrow me-2"></i>Báo Cáo & Biểu Đồ</a></li><li><hr class="dropdown-divider"></li>
                            </ul>
                        </li>
                    }
                </ul>

                <!-- MENU BÊN PHẢI (TÀI KHOẢN) -->
                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1 text-primary"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow" aria-labelledby="userDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-vcard me-2"></i>Hồ sơ & Lịch sử mượn
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-primary rounded-pill px-4" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary rounded-pill px-4" asp-controller="Account" asp-action="Register">Đăng Ký</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

<footer class="bg-dark text-light mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row">
                <!-- Cột 1: Giới thiệu -->
                <div class="col-md-4 mb-4">
                    <h5 class="text-uppercase fw-bold text-primary mb-3">
                        <i class="bi bi-book-half me-2"></i>E-Library
                    </h5>
                    <p class="text-white-50 small">
                        Hệ thống thư viện điện tử hiện đại, cung cấp hàng ngàn đầu sách, giáo trình và tài liệu học thuật phục vụ nhu cầu nghiên cứu và học tập.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-white fs-5 social-icon"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>

                <!-- Cột 2: Liên kết nhanh -->
                <div class="col-md-2 mb-4">
                    <h6 class="text-uppercase fw-bold mb-3">Tài Nguyên</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Sach" asp-action="Index" class="text-white-50 text-decoration-none footer-link">Tất cả sách</a></li>
                        <li class="mb-2"><a asp-controller="Sach" asp-action="Index" asp-route-loai="Giáo trình" class="text-white-50 text-decoration-none footer-link">Giáo trình</a></li>
                        <li class="mb-2"><a asp-controller="Sach" asp-action="Index" asp-route-loai="Tài liệu" class="text-white-50 text-decoration-none footer-link">Luận văn</a></li>
                        <li class="mb-2"><a asp-controller="Sach" asp-action="Index" asp-route-loai="Sách" class="text-white-50 text-decoration-none footer-link">Sách tham khảo</a></li>
                    </ul>
                </div>

               <!-- Cột 3: Hỗ trợ -->
                <div class="col-md-2 mb-4">
                    <h6 class="text-uppercase fw-bold mb-3">Hỗ Trợ</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Rules" class="text-white-50 text-decoration-none footer-link">Quy định mượn</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Guide" class="text-white-50 text-decoration-none footer-link">Hướng dẫn gia hạn</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Fines" class="text-white-50 text-decoration-none footer-link">Biểu phí phạt</a>
                        </li>
                        <li class="mb-2">
                            <a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none footer-link">Liên hệ</a>
                        </li>
                    </ul>
                </div>

                <!-- Cột 4: Liên hệ -->
                <div class="col-md-4 mb-4">
                    <h6 class="text-uppercase fw-bold mb-3">Liên Hệ</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill me-2 text-primary"></i> 123 Đường Nguyễn Văn Cừ, Q.5, TP.HCM</li>
                        <li class="mb-2"><i class="bi bi-envelope-fill me-2 text-primary"></i> support@elibrary.edu.vn</li>
                        <li class="mb-2"><i class="bi bi-telephone-fill me-2 text-primary"></i> (028) 3835 4000</li>
                        <li class="mb-2"><i class="bi bi-clock-fill me-2 text-primary"></i> 8:00 - 17:00 (Thứ 2 - Thứ 6)</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <!-- Bản quyền -->
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start text-white-50 small">
                    &copy; @DateTime.Now.Year <strong>E-Library System</strong>. All Rights Reserved.
                </div>
                <div class="col-md-6 text-center text-md-end text-white-50 small">
                    Võ Tuấn Hùng - Phạm Minh Tuấn
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

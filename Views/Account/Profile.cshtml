@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>
@{ ViewData["Title"] = "Hồ sơ của tôi"; }

<div class="container mt-4">
    <div class="row">
        <!-- Sidebar thông tin -->
        <div class="col-md-3 mb-4">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="mb-3">
                    <img src="https://ui-avatars.com/api/?name=@User.Identity.Name&background=0D8ABC&color=fff&size=128" class="rounded-circle shadow" alt="Avatar">
                </div>
                <h5 class="fw-bold">@User.Identity.Name</h5>
                <p class="text-muted small">Thành viên thư viện</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">Đăng xuất</a>
                </div>
            </div>
        </div>

        <!-- Nội dung chính -->
        <div class="col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h4 class="fw-bold"><i class="bi bi-journal-bookmark-fill text-primary"></i> Lịch Sử Mượn Sách</h4>
                </div>
                <div class="card-body px-4">
                    @if (!Model.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1"></i>
                            <p>Bạn chưa mượn cuốn sách nào.</p>
                            <a asp-controller="Sach" asp-action="Index" class="btn btn-primary">Đi mượn ngay</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sách</th>
                                        <th>Ngày mượn</th>
                                        <th>Hạn trả</th>
                                        <th>Trạng thái</th>
                                        <th>Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.Sach.AnhBia" class="rounded border me-2" style="width: 40px; height: 60px; object-fit: cover;">
                                                    <div>
                                                        <div class="fw-bold text-dark">@item.Sach.TenSach</div>
                                                        <small class="text-muted">@item.Sach.SoHieu</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>@item.NgayMuon.ToString("dd/MM")</td>
                                            <td class="@(item.TrangThai == 0 && item.HanTra < DateTime.Now ? "text-danger fw-bold" : "")">
                                                @item.HanTra.ToString("dd/MM")
                                            </td>
                                            <td>
                                                @if (item.TrangThai == 0) { <span class="badge bg-warning text-dark">Đang mượn</span> }
                                                else { <span class="badge bg-success">Đã trả</span> }
                                            </td>
                                            <td>
                                                @if (item.TrangThai == 0 && item.HanTra >= DateTime.Now && item.SoLanGiaHan == 0)
                                                {
                                                    <a asp-action="GiaHan" asp-route-maPhieu="@item.MaPhieu" class="btn btn-sm btn-outline-info rounded-pill">
                                                        <i class="bi bi-plus-circle"></i> Gia hạn
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
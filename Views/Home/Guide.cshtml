@{ ViewData["Title"] = "Hướng dẫn sử dụng"; }

<div class="container mt-5 mb-5">
    <h2 class="fw-bold text-center mb-5 text-primary">Hướng Dẫn Gia Hạn Sách Online</h2>

    <div class="row g-4">
        <!-- Bước 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="display-4 text-primary fw-bold mb-3">1</div>
                <h5>Đăng nhập hệ thống</h5>
                <p class="text-muted">Truy cập vào website thư viện và đăng nhập bằng tài khoản sinh viên/giảng viên của bạn.</p>
            </div>
        </div>

        <!-- Bước 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="display-4 text-primary fw-bold mb-3">2</div>
                <h5>Vào Hồ sơ cá nhân</h5>
                <p class="text-muted">Click vào tên tài khoản ở góc trên bên phải màn hình, chọn mục <strong>"Hồ sơ & Lịch sử mượn"</strong>.</p>
            </div>
        </div>

        <!-- Bước 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="display-4 text-primary fw-bold mb-3">3</div>
                <h5>Chọn Gia hạn</h5>
                <p class="text-muted">Tại danh sách sách đang mượn, tìm cuốn sách cần gia hạn và bấm nút <strong>"Gia hạn"</strong> (nếu đủ điều kiện).</p>
            </div>
        </div>
    </div>

    <div class="alert alert-warning mt-5 d-flex align-items-center">
        <i class="bi bi-lightbulb-fill fs-3 me-3"></i>
        <div>
            <strong>Lưu ý:</strong> Bạn chỉ có thể gia hạn khi sách <u>chưa quá hạn</u> và số lần gia hạn <u>chưa vượt quá 2 lần</u>.
        </div>
    </div>
</div>
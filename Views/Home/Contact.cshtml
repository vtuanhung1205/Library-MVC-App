@{ ViewData["Title"] = "Liên hệ"; }

<div class="container mt-5 mb-5">
    <div class="row g-5">
        <!-- Thông tin liên hệ -->
        <div class="col-md-5">
            <h2 class="fw-bold text-primary mb-4">Liên Hệ Với Chúng Tôi</h2>
            <p class="text-muted mb-4">Nếu bạn có bất kỳ câu hỏi hoặc đóng góp nào, đừng ngần ngại liên hệ với thư viện qua các kênh dưới đây.</p>
            
            <div class="d-flex mb-3">
                <div class="me-3 text-primary"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Địa chỉ</h6>
                    <p class="text-muted mb-0">123 Đường Nguyễn Văn Cừ, Quận 5, TP.HCM</p>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="me-3 text-primary"><i class="bi bi-envelope-fill fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Email</h6>
                    <p class="text-muted mb-0">support@elibrary.edu.vn</p>
                </div>
            </div>

            <div class="d-flex mb-3">
                <div class="me-3 text-primary"><i class="bi bi-telephone-fill fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-1">Hotline</h6>
                    <p class="text-muted mb-0">(028) 3835 4000</p>
                </div>
            </div>

            <!-- Google Maps Embed (Ví dụ) -->
            <div class="mt-4 rounded-3 overflow-hidden shadow-sm">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.630773293551!2d106.67998301474876!3d10.762913992330719!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752f1c06f4e1dd%3A0x43900f1d4539a3d!2sUniversity%20of%20Science%20-%20VNUHCM!5e0!3m2!1sen!2s!4v1644912345678!5m2!1sen!2s" width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>

        <!-- Form gửi tin nhắn -->
        <div class="col-md-7">
            <div class="card border-0 shadow-lg rounded-3 p-4">
                <h4 class="fw-bold mb-4">Gửi tin nhắn</h4>
                <form>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Họ tên</label>
                            <input type="text" class="form-control" placeholder="Nhập họ tên">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="Nhập email">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Chủ đề</label>
                            <input type="text" class="form-control" placeholder="Vấn đề cần hỗ trợ">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Nội dung</label>
                            <textarea class="form-control" rows="5" placeholder="Nhập nội dung tin nhắn..."></textarea>
                        </div>
                        <div class="col-12">
                            <button type="button" class="btn btn-primary px-4 rounded-pill" onclick="alert('Cảm ơn bạn đã liên hệ! Chúng tôi sẽ phản hồi sớm nhất.')">
                                <i class="bi bi-send-fill me-2"></i> Gửi Tin Nhắn
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@{ ViewData["Title"] = "Biểu phí phạt"; }

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-center mb-4 text-danger">Quy Định Xử Phạt</h2>
            
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead class="bg-danger text-white">
                            <tr>
                                <th class="py-3 ps-4">Loại vi phạm</th>
                                <th class="py-3">Mức phạt (VNĐ)</th>
                                <th class="py-3">Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="ps-4 fw-bold">Trả sách quá hạn</td>
                                <td class="text-danger fw-bold">5.000 đ / ngày / cuốn</td>
                                <td>Tính cả ngày lễ và chủ nhật</td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-bold">Làm mất sách</td>
                                <td class="text-danger fw-bold">Giá bìa x 3</td>
                                <td>Hoặc mua đền cuốn sách mới cùng loại</td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-bold">Làm rách, vẽ bậy</td>
                                <td class="text-danger fw-bold">20.000 - 50.000 đ</td>
                                <td>Tùy mức độ hư hại</td>
                            </tr>
                            <tr>
                                <td class="ps-4 fw-bold">Làm mất mã vạch/tem</td>
                                <td class="text-danger fw-bold">10.000 đ</td>
                                <td>Phí in lại tem</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-4 text-center text-muted">
                <small>Mọi thắc mắc về tiền phạt vui lòng liên hệ trực tiếp tại quầy thủ thư.</small>
            </div>
        </div>
    </div>
</div>
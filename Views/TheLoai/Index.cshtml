@model IEnumerable<QuanLyThuVien.Models.TheLoai>
@{
    ViewData["Title"] = "Quản Lý Thể Loại";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark"><i class="bi bi-tags-fill text-warning"></i> Quản Lý Thể Loại</h2>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> Tạo Mới
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 py-3">ID</th>
                                <th>Tên Thể Loại</th>
                                <th>Thống kê</th>
                                <th class="text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@item.MaTheLoai</td>
                                    <td class="fw-bold text-primary fs-5">@item.TenTheLoai</td>
                                    <td>
                                        <span class="badge bg-info text-dark rounded-pill px-3">
                                            <i class="bi bi-book me-1"></i> @(item.Sachs?.Count ?? 0) đầu sách
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a href="#" class="btn btn-sm btn-light text-primary me-1"><i class="bi bi-pencil-square"></i> Sửa</a>
                                        <a href="#" class="btn btn-sm btn-light text-danger"><i class="bi bi-trash"></i> Xóa</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
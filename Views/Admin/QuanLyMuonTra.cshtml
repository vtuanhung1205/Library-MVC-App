@model IEnumerable<QuanLyThuVien.Models.PhieuMuon>

@{
    ViewData["Title"] = "Quản lý Mượn Trả";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger fw-bold">
            <i class="bi bi-shield-lock-fill"></i> Quản Lý Mượn Trả
        </h2>
        <span class="badge bg-primary fs-6">Tổng phiếu: @Model.Count()</span>
    </div>

    <hr />

    <!-- Hiển thị thông báo thành công/thất bại -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Mã Phiếu</th>
                        <th>Người Mượn</th>
                        <th>Thông Tin Sách</th>
                        <th>Thời Gian</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Hành Động</th>
                        <th>Hạn Trả</th>
                        <th>Phạt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Kiểm tra xem có quá hạn không để bôi đỏ
                        bool isQuaHan = (item.TrangThai == 0 && item.HanTra < DateTime.Now);
                        string rowClass = isQuaHan ? "table-danger" : "";

                        <tr class="@rowClass">
                            <td>#@item.MaPhieu</td>
                            <td>
                                <div class="fw-bold">@item.NguoiDung?.HoTen</div>
                                <small class="text-muted">@item.NguoiDung?.Email</small>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (item.Sach != null)
                                    {
                                        <img src="@item.Sach.AnhBia" style="width: 40px; height: 60px; object-fit: cover; margin-right: 10px;" class="rounded border" />
                                        <div>
                                            <span class="fw-bold text-primary">@item.Sach.TenSach</span><br />
                                            <small class="text-muted">Call No: @item.Sach.SoHieu</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger">Sách đã bị xóa</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div><i class="bi bi-calendar-check"></i> Mượn: @item.NgayMuon.ToString("dd/MM/yyyy")</div>
                                <div class="@(isQuaHan ? "text-danger fw-bold" : "text-muted")">
                                    <i class="bi bi-calendar-x"></i> Hạn: @item.HanTra.ToString("dd/MM/yyyy")
                                </div>
                            </td>
                            <td>
                                @if (item.TrangThai == 0)
                                {
                                    if (isQuaHan)
                                    {
                                        <span class="badge bg-danger">QUÁ HẠN</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Đang mượn</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-success">Đã trả</span>
                                }
                            </td>
                            <td>
                                @item.HanTra.ToString("dd/MM/yyyy")
                                @if(item.SoLanGiaHan > 0) { <span class="badge bg-info">Gia hạn</span> }
                            </td>
                            <td>
                                @if (item.TienPhat > 0)
                                {
                                    <span class="text-danger fw-bold">@item.TienPhat.ToString("N0") đ</span>
                                }
                                else if (item.TrangThai == 0 && DateTime.Now > item.HanTra)
                                {
                                    <span class="text-danger">Dự tính: @(((DateTime.Now - item.HanTra).Days * 5000).ToString("N0")) đ</span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @if (item.TrangThai == 0)
                                {
                                    <!-- Form xác nhận trả sách -->
                                    <form asp-action="XacNhanTra" method="post">
                                        <input type="hidden" name="maPhieu" value="@item.MaPhieu" />
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Xác nhận sinh viên đã trả sách và sách còn nguyên vẹn?');">
                                            <i class="bi bi-check-lg"></i> Nhận Sách
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="bi bi-lock-fill"></i> Hoàn tất</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>